{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 2000000
  },
  "output": {
    "filePath": "AI_CONTEXT_REPOMIX.txt",
    "style": "plain",
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false,
    "truncateBase64": true,
    "includeFullDirectoryStructure": false,
    "git": {
      "sortByChanges": false,
      "includeDiffs": false,
      "includeLogs": false
    }
  },
  "include": [
    "README.md",
    "step3_*.R",
    "step3_*.tex",
    "repomix.config.json",
    "data/summary_metrics.tex",
    "data/axis_limits.tex",
    "data/panel_B2_cdf_tamp.dat"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "outputs/**",
      "V1_030126/**",
      "*.pdf",
      "*.png",
      "*.svg",
      "*.ps",
      "*.eps",
      "*.aux",
      "*.log",
      "*.dvi",
      "*.fls",
      "*.fdb_latexmk",
      "*.out"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
