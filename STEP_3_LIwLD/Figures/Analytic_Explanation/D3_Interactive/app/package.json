{
  "name": "liwld-interactive",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive D3 visualization of Longitudinal Inference Without Longitudinal Data.",
  "type": "module",
  "engines": {
    "node": ">=20.10",
    "pnpm": ">=9"
  },
  "scripts": {
    "copy-data": "node scripts/copy-data.mjs",
    "predev": "node scripts/copy-data.mjs",
    "prebuild": "node scripts/copy-data.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2",
    "katex": "^0.16.11",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-color": "^3.1.0",
    "d3-interpolate": "^3.0.1",
    "d3-contour": "^4.0.2",
    "d3-drag": "^3.0.0",
    "d3-selection": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/katex": "^0.16.7",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.6",
    "@types/d3-color": "^3.1.3",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-selection": "^3.0.10",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
